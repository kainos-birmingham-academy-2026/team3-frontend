<!doctype html>
<html lang="en">
 <head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content="{% block metaDescription %}Explore Kainos Careers and discover current job opportunities.{% endblock %}" />
  <title>{% block title %}Kainos Careers{% endblock %}</title>
  <link rel="icon" type="image/png" href="/images/kainos-favicon.png" />
  <link rel="stylesheet" href="/styles/branding.css" />
  <link rel="stylesheet" href="/styles/header.css" />
  <link rel="stylesheet" href="/styles/modals.css" />
  <link rel="stylesheet" href="/styles/home.css" />
  <link rel="stylesheet" href="/styles/jobRoles.css" />
  <link rel="stylesheet" href="/styles/forms.css" />
  <link rel="stylesheet" href="/styles/footer.css" />
  <link rel="stylesheet" href="/styles/errorPages.css" />
  <link rel="stylesheet" href="/styles/jobRoleDetail.css" />
  <link rel="stylesheet" href="/styles/jobRoleChat.css" />
 </head>
 <body>
  {% include "layouts/header.njk" %}

  <main class="site-main">
   <div class="container">
    {% block content %}{% endblock %}
   </div>
  </main>

  {% include "components/jobRoleChat.njk" %}
  {% include "layouts/footer.njk" %}
  <script src="/scripts/jobRoleChat.js" defer></script>
 </body>
</html>
