{% extends "layouts/base.njk" %}
{% block title %}Kainos | Create job role{% endblock %}
{% block content %}
   <section class="login-panel" aria-labelledby="create-job-role-title">
      <h1 id="create-job-role-title">Create job role</h1>
      {% if errorMessage %}
         {% if errorMessage is string %}
            <p class="form-alert" role="alert">{{ errorMessage }}</p>
         {% else %}
            {% for error in errorMessage %}
               <p class="form-alert" role="alert">{{ error.message }}</p>
            {% endfor %}
         {% endif %}
      {% endif %}
      <p class="form-hint"><span aria-hidden="true">*</span> Required fields</p>
      <form method="post" action="/job-role-create" class="login-form" novalidate>
         <div class="form-field">
            <label for="roleName">Role name <span aria-hidden="true">*</span></label>
            <input id="roleName" name="roleName" type="text" value="{{ jobRole.roleName | default('', true) }}" placeholder="e.g. Software Engineer" maxlength="100" aria-describedby="roleName-character-count" required/>
            <p id="roleName-character-count" class="form-character-count" data-character-count-for="roleName">{{ jobRole.roleName | default('', true) | length }} / 100 characters</p>
         </div>
         <div class="form-field">
            <label for="description">Description <span aria-hidden="true">*</span></label>
            <textarea id="description" name="description" rows="3" maxlength="2000" aria-describedby="description-character-count" required>{{ jobRole.description | default('', true) }}</textarea>
            <p id="description-character-count" class="form-character-count" data-character-count-for="description">{{ jobRole.description | default('', true) | length }} / 2000 characters</p>
         </div>
         <div class="form-field">
            <label for="responsibilities">Responsibilities <span aria-hidden="true">*</span></label>
            <textarea id="responsibilities" name="responsibilities" rows="3" maxlength="2000" aria-describedby="responsibilities-character-count" required>{{ jobRole.responsibilities | default('', true) }}</textarea>
            <p id="responsibilities-character-count" class="form-character-count" data-character-count-for="responsibilities">{{ jobRole.responsibilities | default('', true) | length }} / 2000 characters</p>
         </div>
         <div class="form-field">
            <label for="sharepointUrl">Job specification URL <span aria-hidden="true">*</span></label>
            <input id="sharepointUrl" name="sharepointUrl" type="url" value="{{ jobRole.sharepointUrl | default('', true) }}" placeholder="https://..." maxlength="255" aria-describedby="sharepointUrl-character-count" required/>
            <p id="sharepointUrl-character-count" class="form-character-count" data-character-count-for="sharepointUrl">{{ jobRole.sharepointUrl | default('', true) | length }} / 255 characters</p>
         </div>
         <div class="form-field">
            <label for="numberOfOpenPositions">Number of open positions <span aria-hidden="true">*</span></label>
            <input id="numberOfOpenPositions" name="numberOfOpenPositions" type="number" value="{{ jobRole.numberOfOpenPositions | default('', true) }}" min="1" required/>
         </div>
         <div class="form-field">
            <label for="closingDate">Closing date</label>
            <input id="closingDate" name="closingDate" type="date" value="{{ jobRole.closingDate | default('', true) }}"/>
            <p class="form-hint">If no closing date is set, the role will remain open until manually closed.</p>
         </div>
         <div class="form-field">
            <label for="capabilityId">Capability <span aria-hidden="true">*</span></label>
            <select id="capabilityId" name="capabilityId" required>
               <option value="">Select capability</option>
               {% for capability in capabilityOptions | default([], true) %}
                  <option value="{{ capability.capabilityId }}"{% if jobRole.capabilityId == capability.capabilityId %} selected{% endif %}>{{ capability.capabilityName }}</option>
               {% endfor %}
            </select>
         </div>
         <div class="form-field">
            <label for="bandId">Band <span aria-hidden="true">*</span></label>
            <select id="bandId" name="bandId" required>
               <option value="">Select band</option>
               {% for band in bandOptions | default([], true) %}
                  <option value="{{ band.bandId }}"{% if jobRole.bandId == band.bandId %} selected{% endif %}>{{ band.bandName }}</option>
               {% endfor %}
            </select>
         </div>
         <div class="form-field">
            <label for="locationId">Location <span aria-hidden="true">*</span></label>
            <select id="locationId" name="locationId" required>
               <option value="">Select location</option>
               {% for location in locationOptions | default([], true) %}
                  <option value="{{ location.locationId }}"{% if jobRole.locationId == location.locationId %} selected{% endif %}>{{ location.locationName }}</option>
               {% endfor %}
            </select>
         </div>
         <div class="form-field">
            <label for="statusName">Status</label>
            <input id="statusName" name="statusName" type="text" value="OPEN" readonly/>
         </div>
         <button type="submit" class="button button-solid">Create new role</button>
      </form>
   </section>
   <script src="/scripts/jobRoleCreate.js" defer></script>
{% endblock %}