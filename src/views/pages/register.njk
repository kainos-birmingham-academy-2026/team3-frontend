{% extends "layouts/base.njk" %}

{% block title %}Kainos | Register{% endblock %}

{% block content %}
 <section class="login-panel" aria-labelledby="register-form-title">
   <h1 id="register-form-title">Create your account</h1>

  {% if errorMessage %}
   <p class="form-alert" role="alert">{{ errorMessage }}</p>
  {% endif %}

   <form method="post" action="/register" class="login-form" novalidate>
   <div class="form-field">
    <label for="email">Email</label>
        <div class="field-input">
         <svg class="field-icon" aria-hidden="true" viewBox="0 0 24 24">
            <rect width="18" height="14" x="3" y="5" rx="2"></rect>
            <path d="m3 7 9 6 9-6"></path>
         </svg>
         <input
            id="email"
            name="email"
            type="text"
            autocomplete="email"
            value="{{ formValues.email | default('', true) }}"
            required
         />
        </div>
   </div>

   <div class="form-field">
    <label for="password">Password</label>
        <div class="field-input">
         <svg class="field-icon" aria-hidden="true" viewBox="0 0 24 24">
            <rect width="18" height="11" x="3" y="11" rx="2"></rect>
            <path d="M7 11V7a5 5 0 0 1 10 0v4"></path>
         </svg>
     <input
      id="password"
      name="password"
      type="password"
      autocomplete="new-password"
      aria-describedby="password-requirements"
      minlength="9"
      pattern="(?=.*[a-z])(?=.*[A-Z])(?=.*[^A-Za-z0-9]).{9,}"
      title="Use at least 9 characters, including uppercase and lowercase letters and a special character"
      required
     />
    <button class="password-toggle" type="button" aria-label="Show password" aria-controls="password" aria-pressed="false">
     <svg aria-hidden="true" viewBox="0 0 24 24">
      <path d="M2.1 12a11 11 0 0 1 19.8 0 11 11 0 0 1-19.8 0"></path>
      <circle cx="12" cy="12" r="3"></circle>
      <path class="password-toggle-slash" d="m3 3 18 18"></path>
     </svg>
    </button>
    </div>
   </div>

   <div class="form-field">
    <label for="confirmPassword">Confirm password</label>
    <div class="field-input">
    <svg class="field-icon" aria-hidden="true" viewBox="0 0 24 24">
     <rect width="18" height="11" x="3" y="11" rx="2"></rect>
     <path d="M7 11V7a5 5 0 0 1 10 0v4"></path>
    </svg>
     <input
      id="confirmPassword"
      name="confirmPassword"
      type="password"
      autocomplete="new-password"
      aria-describedby="password-requirements"
      minlength="9"
      required
     />
    <button class="password-toggle" type="button" aria-label="Show confirm password" aria-controls="confirmPassword" aria-pressed="false">
     <svg aria-hidden="true" viewBox="0 0 24 24">
      <path d="M2.1 12a11 11 0 0 1 19.8 0 11 11 0 0 1-19.8 0"></path>
      <circle cx="12" cy="12" r="3"></circle>
      <path class="password-toggle-slash" d="m3 3 18 18"></path>
     </svg>
    </button>
    </div>
   </div>

   <div id="password-requirements" class="password-requirements">
      <p>Your password must:</p>
    <ul>
      <li data-password-rule="length"><span class="requirement-icon" aria-hidden="true">•</span> Be at least 9 characters long</li>
      <li data-password-rule="case"><span class="requirement-icon" aria-hidden="true">•</span> Include uppercase and lowercase letters</li>
      <li data-password-rule="special"><span class="requirement-icon" aria-hidden="true">•</span> Include a special character, such as !, @, # or £</li>
         <li data-password-rule="matching"><span class="requirement-icon" aria-hidden="true">•</span> Be the same in both fields</li>
    </ul>
   </div>

   <button type="submit" class="button button-solid">Create account</button>
  </form>

  <p class="form-footnote">Already have an account? <a href="/login">Sign in</a></p>
 </section>
 <noscript><style>.password-toggle { display: none; }</style></noscript>
 <script src="/scripts/register.js" defer></script>
{% endblock %}
