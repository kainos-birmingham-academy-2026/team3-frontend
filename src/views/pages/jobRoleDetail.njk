{% extends "layouts/base.njk" %}

{% block content %}
  <a href="/job-role-list" class="back-link">← Back to Job Roles</a>

  {% if jobRoleId %}
    <article class="job-role-detail">
      <div class="hero-section">
        <p class="eyebrow">Job Details</p>
        <div class="hero-title-row">
          <h1>{{ jobRoleId.roleName }}</h1>
          {% if jobRoleId %}
            <span class="status-badge status-{{ jobRoleId.status | lower }}">
              {{ jobRoleId.status | capitalize }}
            </span>
          {% endif %}
        </div>
      </div>

      {% if jobRoleId.description %}
        <div class="description-section">
          <h2>Job Description</h2>
          <p>{{ jobRoleId.description }}</p>
        </div>
      {% endif %}

      <div class="detail-grid">
        <div class="detail-section">
          <h2>Job Details</h2>
          <dl>
            <dt>Role Name</dt>
            <dd>{{ jobRoleId.roleName }}</dd>

            <dt>Location</dt>
            <dd>{{ jobRoleId.location }}</dd>

            <dt>Band</dt>
            <dd>{{ jobRoleId.band }}</dd>

            <dt>Capability</dt>
            <dd>{{ jobRoleId.capability }}</dd>

            <dt>Closing Date</dt>
            <dd>{{ jobRoleId.closingDate }}</dd>
          </dl>
        </div>
      </div>

      {% if jobRoleId.status == "open" %}
        <div class="cta-section">
          <a href="https://www.kainos.com/careers" class="button button-primary">Apply Now</a>
        </div>
      {% else %}
        <div class="info-message">
          <p>This position is currently closed. Please check back later for more opportunities.</p>
        </div>
      {% endif %}
    </article>
  {% else %}
    <p class="empty-state">Job role not found.</p>
  {% endif %}
{% endblock %}
