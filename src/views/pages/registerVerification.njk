{% extends "layouts/base.njk" %}

{% block title %}Kainos | Enter verification code{% endblock %}

{% block content %}
 <section class="login-panel" aria-labelledby="register-verification-title">
    <h1 id="register-verification-title">Check your email</h1>
    <p>Enter the 5-digit code we sent to your email address.</p>

    {% if errorMessage %}
     <p class="form-alert" role="alert">{{ errorMessage }}</p>
    {% endif %}

    <form method="post" action="/register/verify" class="login-form">
     <div class="form-field">
        <label for="verificationCode">5-digit code</label>
        <input
         id="verificationCode"
         name="verificationCode"
         type="text"
         inputmode="numeric"
         autocomplete="one-time-code"
         pattern="[0-9]{5}"
         maxlength="5"
         value="{{ formValues.verificationCode | default('', true) }}"
         required
        />
     </div>

     <button type="submit" class="button button-solid">Verify code</button>
    </form>
 </section>
{% endblock %}