{% extends "layouts/base.njk" %}
{% block content %}
  <section class="page-hero">
    <p class="eyebrow">Careers</p>
    <h1>{% if currentUserRole == 'ADMIN' %}Job roles{% else %}Open job roles{% endif %}</h1>
    <p>{% if currentUserRole == 'ADMIN' %}View and manage all job roles.{% else %}Explore current opportunities and apply before the closing date.{% endif %}</p>
    {% if currentUserRole == 'ADMIN' %}
      <p>
        <a class="button button-solid" href="/job-role-create">Create new role</a>
      </p>
    {% endif %}
  </section>
  <form id="job-role-filters" class="job-role-filters" method="get" action="/job-role-list">
    <input type="hidden" name="filterSubmission" value="true">
    <h2>Filter job roles</h2>
    <div class="job-role-filter-grid">
      <div class="job-role-filter-field role-name-filter-field">
        <label for="roleName">Role name</label>
        <input id="roleName" name="roleName" type="text" value="{{ filters.roleName or '' }}">
      </div>
      <fieldset class="job-role-filter-field location-filter-field">
        <legend>Location</legend>
        <div class="job-role-checkbox-list">
          {% for location in locationOptions %}
            <label for="location-{{ location.locationId }}">
              <input
                id="location-{{ location.locationId }}"
                name="locationId"
                type="checkbox"
                value="{{ location.locationId }}"
                {% if selectedLocationIds[location.locationId] %}checked{% endif %}>
              {{ location.locationName }}
            </label>
          {% endfor %}
        </div>
      </fieldset>
      <fieldset class="job-role-filter-field capability-filter-field">
        <legend>Capability</legend>
        <div class="job-role-checkbox-list">
          {% for capability in capabilityOptions %}
            <label for="capability-{{ capability.capabilityId }}">
              <input
                id="capability-{{ capability.capabilityId }}"
                name="capabilityId"
                type="checkbox"
                value="{{ capability.capabilityId }}"
                {% if selectedCapabilityIds[capability.capabilityId] %}checked{% endif %}>
              {{ capability.capabilityName }}
            </label>
          {% endfor %}
        </div>
      </fieldset>
      <fieldset class="job-role-filter-field band-filter-field">
        <legend>Band</legend>
        <div class="job-role-checkbox-list">
          {% for band in bandOptions %}
            <label for="band-{{ band.bandId }}">
              <input
                id="band-{{ band.bandId }}"
                name="bandId"
                type="checkbox"
                value="{{ band.bandId }}"
                {% if selectedBandIds[band.bandId] %}checked{% endif %}>
              {{ band.bandName }}
            </label>
          {% endfor %}
        </div>
      </fieldset>
      <fieldset class="job-role-filter-field closing-date-filter-field">
        <legend>Closing date</legend>
        <div class="job-role-date-range">
          <label for="closingDateFrom">
            Closing on or after
            <input id="closingDateFrom" name="closingDateFrom" type="date" value="{{ filters.closingDateFrom or '' }}">
          </label>
          <label for="closingDateTo">
            Closing on or before
            <input id="closingDateTo" name="closingDateTo" type="date" value="{{ filters.closingDateTo or '' }}">
          </label>
        </div>
      </fieldset>
      {% if currentUserRole == 'ADMIN' %}
        <fieldset class="job-role-filter-field status-filter-field">
          <legend>Status</legend>
          <select id="status" name="status">
            <option value="">All roles</option>
            <option value="open" {% if filters.status == 'open' %}selected{% endif %}>Open</option>
            <option value="closed" {% if filters.status == 'closed' %}selected{% endif %}>Closed</option>
          </select>
        </fieldset>
      {% endif %}
    </div>
    <div class="job-role-filter-actions">
      <button class="button button-solid" type="submit">Apply filters</button>
      <a href="/job-role-list?clearFilters=true">Clear filters</a>
    </div>
  </form>
  {% set hasVisibleRoles = false %}
  {% for jobRole in jobRoles %}
    {% if currentUserRole == 'ADMIN' or jobRole.status == "open" %}
      {% set hasVisibleRoles = true %}
    {% endif %}
  {% endfor %}
  {% if hasVisibleRoles %}
    <div class="job-role-table-scroll" tabindex="0" aria-label="Job roles table">
      <table class="job-role-table">
        <thead>
          <tr>
            <th scope="col">Role Name</th>
            <th scope="col">Location</th>
            <th scope="col">Capability</th>
            <th scope="col">Band</th>
            {% if currentUserRole == 'ADMIN' %}<th scope="col">Status</th>{% endif %}
            {% if currentUserRole == 'ADMIN' %}<th scope="col">Opening Date</th>{% endif %}
            <th scope="col">Closing Date</th>
            {% if currentUserRole and currentUserRole != 'ADMIN' %}<th scope="col"><span class="visually-hidden">Application status</span></th>{% endif %}
          </tr>
        </thead>
        <tbody>
          {% for jobRole in jobRoles %}
            {% if currentUserRole == 'ADMIN' or jobRole.status == "open" %}
              {% set hasApplied = currentUserRole and currentUserRole != 'ADMIN' and appliedJobRoleIds[jobRole.jobRoleId] %}
              <tr
                class="job-role-row-link"
                data-href="/job-role-list/{{ jobRole.jobRoleId }}"
                role="link"
                tabindex="0"
                aria-label="View details for {{ jobRole.roleName }}{% if hasApplied %} (already applied){% endif %}">
                <td>
                  <a href="/job-role-list/{{ jobRole.jobRoleId }}">{{ jobRole.roleName }}</a>
                </td>
                <td>{{ jobRole.location }}</td>
                <td>{{ jobRole.capability }}</td>
                <td>{{ jobRole.band }}</td>
                {% if currentUserRole == 'ADMIN' %}<td><span class="status-badge status-{{ jobRole.status | lower }}">{{ jobRole.status | capitalize }}</span></td>{% endif %}
                {% if currentUserRole == 'ADMIN' %}<td>{{ jobRole.openingDate }}</td>{% endif %}
                <td>{{ jobRole.closingDate }}</td>
                {% if currentUserRole and currentUserRole != 'ADMIN' %}
                  <td class="job-role-status-cell">
                    {% if hasApplied %}<span class="status-badge status-applied">Applied</span>{% endif %}
                  </td>
                {% endif %}
              </tr>
            {% endif %}
          {% endfor %}
        </tbody>
      </table>
    </div>
  {% else %}
    <p class="empty-state">{% if currentUserRole == 'ADMIN' %}No job roles found{% else %}No open job roles found{% endif %}</p>
  {% endif %}
  {% if pagination.totalPages > 1 %}
    <nav class="application-pagination" aria-label="Job role pages">
      {% if pagination.page > 1 %}
        {% if pagination.totalPages >= 3 %}
          <button class="pagination-link" type="submit" name="page" value="1" form="job-role-filters" aria-label="First page">&lt;&lt;</button>
        {% endif %}
        <button class="pagination-link" type="submit" name="page" value="{{ pagination.page - 1 }}" form="job-role-filters" aria-label="Previous page">&lt;</button>
      {% endif %}
      <span>Page {{ pagination.page }} of {{ pagination.totalPages }}</span>
      {% if pagination.page < pagination.totalPages %}
        <button class="pagination-link" type="submit" name="page" value="{{ pagination.page + 1 }}" form="job-role-filters" aria-label="Next page">&gt;</button>
        {% if pagination.totalPages >= 3 %}
          <button class="pagination-link" type="submit" name="page" value="{{ pagination.totalPages }}" form="job-role-filters" aria-label="Last page">&gt;&gt;</button>
        {% endif %}
      {% endif %}
    </nav>
  {% endif %}
  <script>
    const closingDateFromInput = document.getElementById("closingDateFrom");
    const closingDateToInput = document.getElementById("closingDateTo");

    const syncClosingDateFilters = () => {
      closingDateFromInput.disabled = Boolean(closingDateToInput.value);
      closingDateToInput.disabled = Boolean(closingDateFromInput.value);
    };

    closingDateFromInput.addEventListener("input", syncClosingDateFilters);
    closingDateToInput.addEventListener("input", syncClosingDateFilters);
    syncClosingDateFilters();

    document.querySelectorAll(".job-role-row-link").forEach((row) => {
      const navigateToRole = () => {
        const href = row.getAttribute("data-href");
        if (href) {
          window.location.href = href;
        }
      };

      row.addEventListener("click", navigateToRole);
      row.addEventListener("keydown", (event) => {
        if (event.key === "Enter" || event.key === " ") {
          event.preventDefault();
          navigateToRole();
        }
      });
    });
  </script>
{% endblock %}