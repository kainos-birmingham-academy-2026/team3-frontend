{% extends "layouts/base.njk" %}

{% block content %}
 <section class="page-hero">
  <p class="eyebrow">Careers</p>
  <h1>Open job roles</h1>
  <p>Explore current opportunities and apply before the closing date.</p>
 </section>

 {% set hasOpenRoles = false %}
 {% for jobRole in jobRoles %}
  {% if jobRole.status == "open" %}
   {% set hasOpenRoles = true %}
  {% endif %}
 {% endfor %}

 {% if hasOpenRoles %}
   <table class="job-role-table">
     <thead>
       <tr>
        <th>Role Name</th>
        <th>Location</th>
        <th>Capability</th>
        <th>Band</th>
        <th>Closing Date</th>
       </tr>
     </thead>
     <tbody>
      {% for jobRole in jobRoles %}
       {% if jobRole.status == "open" %}
        <tr>
         <td>{{ jobRole.roleName }}</td>
         <td>{{ jobRole.location }}</td>
         <td>{{ jobRole.capabilityId }}</td>
         <td>{{ jobRole.bandId }}</td>
         <td>{{ jobRole.closingDate }}</td>
        </tr>
       {% endif %}
      {% endfor %}
     </tbody>
   </table>
 {% else %}
  <p class="empty-state">No open job roles found</p>
 {% endif %}
{% endblock %}
