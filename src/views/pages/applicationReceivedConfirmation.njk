{% extends "layouts/base.njk" %}

{% block title %}Application received | Kainos Careers{% endblock %}

{% block content %}
 <section class="restricted-page" aria-labelledby="application-received-title">
  <div class="restricted-card">
   <h1 id="application-received-title">Application received</h1>
   <p>Thank you for applying. Your application has been submitted successfully and is now in progress.</p>
   <div class="confirmation-actions">
    <a href="{{ jobRoleListUrl }}" class="button button-outline">Back to job roles</a>
    <a href="/job-applications" class="button button-solid">View my applications</a>
   </div>
  </div>
 </section>
{% endblock %}
