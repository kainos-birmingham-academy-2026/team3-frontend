{% extends "layouts/base.njk" %}

{% block title %}Kainos | Home{% endblock %}

{% block content %}
 <section class="home-hero">
  <p class="eyebrow">Kainos</p>
  <h1>True partners change the world together</h1>
  <p>
   We are on a mission to make people's lives better through technology. Explore
   open opportunities and join teams delivering meaningful digital transformation.
  </p>
  <div class="hero-actions">
   <a class="button button-solid" href="/job-role-list">View job roles</a>
   <a class="button button-outline" href="https://www.kainos.com/contact-us">Contact us</a>
  </div>
 </section>

 <section class="home-cards" aria-label="Service areas">
  <article class="card">
   <h2>Digital Services</h2>
   <p>
    Build digital services and engineering capabilities that support continuous growth.
   </p>
   <a href="https://www.kainos.com/digital-services" class="link-underlined">Discover Digital Services</a>
  </article>
  <article class="card">
   <h2>Workday</h2>
   <p>
    Deploy and optimize Workday with trusted expertise across your organization.
   </p>
   <a href="https://www.kainos.com/workday" class="link-underlined">Discover Workday</a>
  </article>
 </section>
{% endblock %}
