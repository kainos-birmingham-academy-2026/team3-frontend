{% extends "layouts/base.njk" %}

{% block title %}Kainos | Sign in{% endblock %}

{% block content %}
 <section class="page-hero login-hero">
  <p class="eyebrow">Kainos Careers</p>
	<h1>Sign in to view job opportunities</h1>
 </section>

 <section class="login-panel" aria-labelledby="login-form-title">
  <h2 id="login-form-title">Welcome back</h2>

	{% if successMessage %}
	 <p class="form-success" role="status">{{ successMessage }}</p>
	{% endif %}

  {% if errorMessage %}
   <p class="form-alert" role="alert">{{ errorMessage }}</p>
  {% endif %}

  <form method="post" action="/login" class="login-form" novalidate>
   <div class="form-field">
	<label for="email">Email</label>
	<div class="field-input">
	 <svg class="field-icon" aria-hidden="true" viewBox="0 0 24 24">
	  <rect width="18" height="14" x="3" y="5" rx="2"></rect>
	  <path d="m3 7 9 6 9-6"></path>
	 </svg>
	<input
	 id="email"
	 name="email"
	 type="text"
	 autocomplete="email"
	 value="{{ formValues.email | default('', true) }}"
	 required
	/>
	</div>
   </div>

   <div class="form-field">
	<label for="password">Password</label>
	<div class="field-input">
	 <svg class="field-icon" aria-hidden="true" viewBox="0 0 24 24">
	  <rect width="18" height="11" x="3" y="11" rx="2"></rect>
	  <path d="M7 11V7a5 5 0 0 1 10 0v4"></path>
	 </svg>
	<input
	 id="password"
	 name="password"
	 type="password"
	 autocomplete="current-password"
	 required
	/>
	<button class="password-toggle" type="button" aria-label="Show password" aria-controls="password" aria-pressed="false">
	 <svg aria-hidden="true" viewBox="0 0 24 24">
	  <path d="M2.1 12a11 11 0 0 1 19.8 0 11 11 0 0 1-19.8 0"></path>
	  <circle cx="12" cy="12" r="3"></circle>
	  <path class="password-toggle-slash" d="m3 3 18 18"></path>
	 </svg>
	</button>
	</div>
   </div>

   <button type="submit" class="button button-solid">Sign in</button>
  </form>

	<p class="form-footnote">New here? <a href="/register">Create an account</a></p>
 </section>
 <noscript><style>.password-toggle { display: none; }</style></noscript>
 <script src="/scripts/register.js" defer></script>
{% endblock %}
