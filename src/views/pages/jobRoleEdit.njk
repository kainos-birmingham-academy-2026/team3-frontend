{% extends "layouts/base.njk" %}
{% block title %}Kainos | Edit job role{% endblock %}
{% block content %}
  <section class="login-panel" aria-labelledby="edit-job-role-title">
    <a href="/job-role-list/{{ jobRole.jobRoleId }}" class="back-link">← Back to job role</a>
    <h1 id="edit-job-role-title">Edit job role</h1>
    {% if errorMessage %}
      {% if errorMessage is string %}
        <p class="form-alert" role="alert">{{ errorMessage }}</p>
      {% else %}
        {% for error in errorMessage %}
          <p class="form-alert" role="alert">{{ error.message }}</p>
        {% endfor %}
      {% endif %}
    {% endif %}
    <p class="form-hint"><span aria-hidden="true">*</span> Required fields</p>
    <form method="post" action="/job-role-edit" class="login-form" novalidate>
      <input type="hidden" name="jobRoleId" value="{{ jobRole.jobRoleId }}"/>
      <div class="form-field">
        <label for="roleName">Role name <span aria-hidden="true">*</span></label>
        <input id="roleName" name="roleName" type="text" maxlength="{{ characterLimits.roleName }}" value="{{ jobRole.roleName }}" aria-describedby="roleName-character-count" required/>
        <p id="roleName-character-count" class="form-character-count" data-character-count-for="roleName"></p>
      </div>
      <div class="form-field">
        <label for="description">Description <span aria-hidden="true">*</span></label>
        <textarea id="description" name="description" rows="3" maxlength="{{ characterLimits.description }}" aria-describedby="description-character-count" required>{{ jobRole.description }}</textarea>
        <p id="description-character-count" class="form-character-count" data-character-count-for="description"></p>
      </div>
      <div class="form-field">
        <label for="responsibilities">Responsibilities <span aria-hidden="true">*</span></label>
        <textarea id="responsibilities" name="responsibilities" rows="3" maxlength="{{ characterLimits.responsibilities }}" aria-describedby="responsibilities-character-count" required>{{ jobRole.responsibilities }}</textarea>
        <p id="responsibilities-character-count" class="form-character-count" data-character-count-for="responsibilities"></p>
      </div>
      <div class="form-field">
        <label for="sharepointUrl">Job specification URL <span aria-hidden="true">*</span></label>
        <input id="sharepointUrl" name="sharepointUrl" type="url" maxlength="{{ characterLimits.sharepointUrl }}" value="{{ jobRole.jobSpecUrl }}" aria-describedby="sharepointUrl-character-count" required/>
        <p id="sharepointUrl-character-count" class="form-character-count" data-character-count-for="sharepointUrl"></p>
      </div>
      <div class="form-field">
        <label for="numberOfOpenPositions">Number of open positions <span aria-hidden="true">*</span></label>
        <input id="numberOfOpenPositions" name="numberOfOpenPositions" type="number" min="1" step="1" value="{{ jobRole.openPositions }}" required/>
      </div>
      <div class="form-field">
        <label for="closingDate">Closing date</label>
        <input id="closingDate" name="closingDate" type="date" min="{{ minClosingDate }}" value="{{ jobRole.closingDate }}"/>
      </div>
      <div class="form-field">
        <label for="capabilityId">Capability <span aria-hidden="true">*</span></label>
        <select id="capabilityId" name="capabilityId" required>
          <option value="">Select capability</option>
          {% for capability in capabilityOptions | default([], true) %}
            <option value="{{ capability.capabilityId }}" {% if capability.capabilityName == jobRole.capability or capability.capabilityId == jobRole.capabilityId %}selected{% endif %}>{{ capability.capabilityName }}</option>
          {% endfor %}
        </select>
      </div>
      <div class="form-field">
        <label for="bandId">Band <span aria-hidden="true">*</span></label>
        <select id="bandId" name="bandId" required>
          <option value="">Select band</option>
          {% for band in bandOptions | default([], true) %}
            <option value="{{ band.bandId }}" {% if band.bandName == jobRole.band or band.bandId == jobRole.bandId %}selected{% endif %}>{{ band.bandName }}</option>
          {% endfor %}
        </select>
      </div>
      <div class="form-field">
        <label for="locationId">Location <span aria-hidden="true">*</span></label>
        <select id="locationId" name="locationId" required>
          <option value="">Select location</option>
          {% for location in locationOptions | default([], true) %}
            <option value="{{ location.locationId }}" {% if location.locationName == jobRole.location or location.locationId == jobRole.locationId %}selected{% endif %}>{{ location.locationName }}</option>
          {% endfor %}
        </select>
      </div>
      <button type="submit" class="button button-solid">Save changes</button>
    </form>
  </section>
  <script src="/scripts/jobRoleCreate.js" defer></script>
{% endblock %}