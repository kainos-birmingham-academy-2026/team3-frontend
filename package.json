{
	"scripts": {
		"dev": "tsx watch src/index.ts",
		"build": "tsc",
		"start": "node dist/index.js",
		"lint": "biome check",
		"lint:fix": "biome check --write .",
		"ci:check": "biome ci",
		"test": "vitest run",
		"test:watch": "vitest",
		"test:ui": "vitest run --ui",
		"test:coverage": "vitest run --coverage",
		"e2e": "bddgen && playwright test",
		"e2e:bdd": "bddgen && playwright test e2e/specs/e2e/bdd",
		"e2e:smoke": "playwright test --grep @smoke",
		"e2e:headed": "E2E_SKIP_BACKEND=true playwright test --headed",
		"e2e:ui": "playwright test --ui",
		"e2e:report": "playwright show-report"
	},
	"dependencies": {
		"@playwright/mcp": "^0.0.79",
		"axios": "^1.19.0",
		"dotenv": "^17.4.2",
		"express": "^5.2.1",
		"express-session": "^1.19.0",
		"nunjucks": "^3.2.4"
	},
	"devDependencies": {
		"@biomejs/biome": "^2.5.7",
		"@playwright/test": "^1.62.1",
		"@types/express": "^5.0.0",
		"@types/express-session": "^1.19.0",
		"@types/node": "^24.0.0",
		"@types/nunjucks": "^3.2.6",
		"@types/pg": "^8.23.1",
		"@types/supertest": "^7.2.1",
		"@vitest/coverage-v8": "^4.1.10",
		"pg": "^8.23.0",
		"playwright-bdd": "^9.2.0",
		"supertest": "^7.2.2",
		"tsx": "^4.0.0",
		"typescript": "^5.0.0",
		"vitest": "^4.1.10"
	}
}
