# Frontend URL tested by Playwright. Defaults to http://127.0.0.1:3000.
# PLAYWRIGHT_BASE_URL=https://example.com

# Backend URL used by the frontend and Playwright setup.
API_BASE_URL=http://localhost:4000

# Database used by E2E setup and assertions.
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/team3

# Local frontend settings.
PORT=3000
SESSION_SECRET=replace-with-a-long-random-secret# Copy this file to .env.e2e and set real values once.
# Playwright auto-loads .env and .env.e2e from playwright.config.ts.

# Candidate user used by auth-apply-flow journey test
E2E_USER_EMAIL=your-candidate-email@example.com
E2E_USER_PASSWORD=your-candidate-password

# Target open role to apply for
E2E_JOB_ROLE_ID=123

# Admin user used for cleanup (delete created application)
E2E_ADMIN_EMAIL=your-admin-email@example.com
E2E_ADMIN_PASSWORD=your-admin-password

# Delete endpoint template used during cleanup.
# Must include :id or {id} placeholder.
E2E_APPLICATION_DELETE_PATH_TEMPLATE=/api/job-applications/:id

# Optional override for frontend base URL
# PLAYWRIGHT_BASE_URL=http://127.0.0.1:3000
