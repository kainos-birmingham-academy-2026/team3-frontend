# Frontend URL tested by Playwright. Defaults to http://127.0.0.1:3000.
# PLAYWRIGHT_BASE_URL=https://example.com

# Local backend URL used by Playwright setup.
API_BASE_URL=http://localhost:4000

# Local database used by E2E setup and assertions.
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/team3

# Local frontend settings.
PORT=3000
SESSION_SECRET=replace-with-a-long-random-secret
